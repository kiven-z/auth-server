# 复制为 service-system.env 后按需填写（勿提交真实密钥）
AUTH_EMAIL_CONFIG_USERNAME=
AUTH_DING_TALK_CLIENT_SECRET=
AUTH_DING_TALK_AGENT_ID=
AUTH_AI_API_KEY=your-ai-api-key
AUTH_SMS_ACCESS_KEY_SECRET=
AUTH_EMAIL_CONFIG_PASSWORD=
AUTH_DING_TALK_CLIENT_ID=
AUTH_DING_TALK_APP_ID=
AUTH_SMS_ACCESS_KEY_ID=
AUTH_SERVICE_SYSTEM_MESSAGE_CHANNEL_EMAIL_ENABLED=true
AUTH_SERVICE_SYSTEM_MESSAGE_CHANNEL_SMS_ENABLED=false
AUTH_SERVICE_SYSTEM_MESSAGE_CHANNEL_DING_TALK_ENABLED=false

# 可选：覆盖 Nacos 中的库账号 / Redis / MinIO（未设置则用 Nacos 默认值）
# AUTH_DB_USERNAME=dev_user
# AUTH_DB_PASSWORD=Dev1234!
# AUTH_REDIS_PASSWORD=Dev1234!
# AUTH_FILE_MINIO_ENDPOINT=http://minio:9000
# AUTH_FILE_MINIO_PUBLIC_URL=http://202.189.51.251:9000
# AUTH_FILE_MINIO_ACCESS_KEY=admin
# AUTH_FILE_MINIO_SECRET_KEY=Dev1234!
# AUTH_FILE_MINIO_BUCKET=auth-files-prod
