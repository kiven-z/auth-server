<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.system.admin.mapper.permission.SysPermissionMapper">

    <!-- 分页查询权限：仅查业务表；创建人/更新人用户名由 {@link com.auth.service.system.common.service.AuditUserDisplayService} 批量补全 -->
    <select id="selectListByPage" resultType="com.auth.service.system.admin.model.entity.SysPermissionEntity">
        SELECT
            p.id,
            p.permission_code,
            p.permission_name,
            p.permission_type,
            p.order_num,
            p.status,
            p.create_time,
            p.update_time,
            p.create_user,
            p.update_user
        FROM
            sys_permission p
        <where>
            <if test="query.permissionCode != null and query.permissionCode != ''">
                AND p.permission_code LIKE CONCAT('%', #{query.permissionCode}, '%')
            </if>
            <if test="query.permissionName != null and query.permissionName != ''">
                AND p.permission_name LIKE CONCAT('%', #{query.permissionName}, '%')
            </if>
            <if test="query.permissionType != null">
                AND p.permission_type = #{query.permissionType}
            </if>
            <if test="query.status != null">
                AND p.status = #{query.status}
            </if>
        </where>
        ORDER BY
            ${orderBySql}
    </select>

</mapper>
