<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.system.schedule.mapper.JobLogMapper">

    <!-- 按任务取最近若干条 -->
    <select id="selectRecentByJobNameAndGroup"
            resultType="com.auth.service.system.log.model.entity.JobLogEntity">
        SELECT id,
        job_name,
        job_group,
        invoke_target,
        job_message,
        status,
        exception_info,
        elapsed_time,
        create_time
        FROM log_job
        <where>
            <if test="jobName != null and jobName != ''">
                AND job_name = #{jobName}
            </if>
            <if test="jobGroup != null and jobGroup != ''">
                AND job_group = #{jobGroup}
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{limit}
    </select>

    <!-- 按任务键物理删除全部日志 -->
    <delete id="deleteByJobNameAndGroup">
        DELETE
        FROM log_job
        WHERE job_name = #{jobName}
          AND job_group = #{jobGroup}
    </delete>
</mapper>