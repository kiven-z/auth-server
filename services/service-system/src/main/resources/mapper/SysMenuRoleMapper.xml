<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.system.admin.mapper.SysMenuRoleMapper">

    <!-- 查询菜单已分配角色（左连 sys_role 获取角色名称） -->
    <select id="selectAssignedRolesByMenuId"
            resultType="com.auth.service.system.admin.model.dto.menu.SysMenuAssignedRoleDTO">
        SELECT mr.role_code,
               r.role_name
        FROM sys_menu_role mr
                 LEFT JOIN sys_role r ON r.role_code = mr.role_code AND r.status = 1 AND r.is_deleted = 0
        WHERE mr.menu_id = #{menuId}
        ORDER BY r.order_num
    </select>

    <!-- 根据菜单ID删除所有角色关联 -->
    <delete id="deleteByMenuId">
        DELETE FROM sys_menu_role WHERE menu_id = #{menuId}
    </delete>

    <!-- 批量插入菜单-角色关联 -->
    <insert id="batchInsertMenuRoles">
        INSERT INTO sys_menu_role (menu_id, role_code) VALUES
        <foreach collection="roleCodes" item="roleCode" separator=",">
            (#{menuId}, #{roleCode})
        </foreach>
    </insert>
</mapper>