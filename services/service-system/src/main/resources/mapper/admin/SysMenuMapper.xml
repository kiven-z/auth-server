<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.system.admin.mapper.SysMenuMapper">

    <!-- 菜单列表查询条件（不含逻辑删除） -->
    <sql id="listWhere">
        SELECT   m.id,
        m.parent_id,
        m.name,
        m.title,
        m.icon,
        m.path,
        m.component,
        m.menu_type,
        m.status,
        m.show_link,
        m.menu_rank,
        m.keep_alive,
        m.fixed_tag,
        m.remark,
        m.create_time,
        m.update_time, 
        m.create_user,
        m.update_user   FROM sys_menu m
        <where>
            m.is_deleted = 0
            <if test="query.name != null and query.name != ''">
                AND m.name LIKE CONCAT('%', #{query.name}, '%')
            </if>
            <if test="query.title != null and query.title != ''">
                AND m.title LIKE CONCAT('%', #{query.title}, '%')
            </if>
            <if test="query.menuType != null">
                AND m.menu_type = #{query.menuType}
            </if>
            <if test="query.status != null">
                AND m.status = #{query.status}
            </if>
            <if test="query.component != null and query.component != ''">
                AND m.component LIKE CONCAT('%', #{query.component}, '%')
            </if>
        </where>       
        ORDER BY m.menu_rank , m.id
    </sql>

    <!-- 菜单扁平列表查询（无分页，供树形构建） -->
    <select id="selectListByQuery"
            resultType="com.auth.service.system.admin.model.entity.SysMenuEntity">
        <include refid="listWhere"/>
    </select>

    <!-- 分页查询菜单 -->
    <select id="selectPageByQuery"
            resultType="com.auth.service.system.admin.model.entity.SysMenuEntity">
        <include refid="listWhere"/>
    </select>

</mapper>
