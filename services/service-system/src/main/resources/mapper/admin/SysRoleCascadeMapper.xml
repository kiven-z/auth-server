<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.system.admin.mapper.SysRoleCascadeMapper">

    <!-- 删除菜单角色关联 -->
    <delete id="deleteMenuRolesByRoleCode">
        DELETE
        FROM sys_menu_role
        WHERE role_code = #{roleCode}
    </delete>

    <!-- 角色码变更：级联 grant_table -->
    <update id="updateGrantTableRoleCode">
        UPDATE grant_table
        SET role_code = #{newRoleCode}
        WHERE role_code = #{oldRoleCode}
    </update>

    <!-- 角色码变更：级联 sys_role_permission -->
    <update id="updateRolePermissionRoleCode">
        UPDATE sys_role_permission
        SET role_code = #{newRoleCode}
        WHERE role_code = #{oldRoleCode}
    </update>

    <!-- 角色码变更：级联 sys_menu_role -->
    <update id="updateMenuRoleRoleCode">
        UPDATE sys_menu_role
        SET role_code = #{newRoleCode}
        WHERE role_code = #{oldRoleCode}
    </update>

</mapper>
