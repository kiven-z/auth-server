<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.system.admin.mapper.SysRoleCascadeMapper">

    <!-- 删除菜单角色关联 -->
    <delete id="deleteMenuRolesByRoleCode">
        DELETE
        FROM sys_menu_role
        WHERE role_code = #{roleCode}
    </delete>

</mapper>
