<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.system.admin.mapper.PostReferenceMapper">

    <!-- 岗位下用户-岗位关联 -->
    <select id="countUserPostByPostId" resultType="long">
        SELECT COUNT(1)
        FROM user_post up
        WHERE up.post_id = #{postId}
          AND up.status IN (1, 2)
    </select>

    <!-- grant_table POST 主体 -->
    <select id="countGrantPostSubjectByPostId" resultType="long">
        SELECT COUNT(1)
        FROM grant_table gt
        WHERE gt.subject_type = 'POST'
          AND gt.subject_id = #{postId}
    </select>

</mapper>
