<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.system.admin.mapper.DeptClosureMapper">

    <!-- 新增部门：维护 dept_closure -->
    <update id="callInsert" statementType="CALLABLE">
        {CALL sp_dept_insert(#{deptId, mode=IN, jdbcType=BIGINT},
                             #{parentId, mode=IN, jdbcType=BIGINT})}
    </update>

    <!-- 物理删除子树：移除闭包路径 -->
    <update id="callDeleteSubtree" statementType="CALLABLE">
        {CALL sp_dept_delete(#{deptId, mode=IN, jdbcType=BIGINT})}
    </update>

    <!-- 移动部门：重算闭包路径 -->
    <update id="callMove" statementType="CALLABLE">
        {CALL sp_dept_move(#{deptId, mode=IN, jdbcType=BIGINT},
                           #{newParentId, mode=IN, jdbcType=BIGINT})}
    </update>

</mapper>
