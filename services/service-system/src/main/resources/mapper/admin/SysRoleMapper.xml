<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.system.admin.mapper.SysRoleMapper">

    <!-- 角色分页列表：仅查业务表；创建人/更新人用户名由 {@link com.auth.service.system.common.service.AuditUserDisplayService} 批量补全 -->
    <select id="selectListByPage" resultType="com.auth.service.system.admin.model.entity.SysRoleEntity">
        SELECT
        r.id,
        r.role_code,
        r.role_name,
        r.status,
        r.role_type,
        r.order_num,
        r.create_time,
        r.update_time,
        r.create_user,
        r.update_user
        FROM sys_role r
        <where>
            <if test="query.roleCode != null and query.roleCode != ''">
                AND r.role_code LIKE CONCAT('%', #{query.roleCode}, '%')
            </if>
            <if test="query.roleName != null and query.roleName != ''">
                AND r.role_name LIKE CONCAT('%', #{query.roleName}, '%')
            </if>
            <if test="query.status != null">
                AND r.status = #{query.status}
            </if>
            <if test="query.roleTypes != null and query.roleTypes.size() > 0">
                AND r.role_type IN
                <foreach collection="query.roleTypes" item="roleTypeItem" open="(" separator="," close=")">
                    #{roleTypeItem}
                </foreach>
            </if>
        </where>
        ORDER BY ${orderBySql}
    </select>

    <!-- 查询角色下拉选项 -->
    <select id="selectRoleOptions" resultType="com.auth.service.system.admin.model.entity.SysRoleEntity">
        SELECT id, role_code, role_name FROM sys_role
        <where>
            status = 1
            <if test="roleName != null and roleName != ''">AND role_name LIKE CONCAT('%', #{roleName}, '%')</if>
            <if test="roleCode != null and roleCode != ''">AND role_code LIKE CONCAT('%', #{roleCode}, '%')</if>
        </where>
        ORDER BY order_num LIMIT 15
    </select>
</mapper>
