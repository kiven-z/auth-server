<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.system.message.mapper.EmailTemplateMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.auth.service.system.message.model.EmailTemplateEntity">
        <id column="id" property="id"/>
        <id column="template_code" property="templateCode"/>
        <id column="template_name" property="templateName"/>
        <id column="description" property="description"/>
        <id column="subject" property="subject"/>
        <id column="content" property="content"/>
        <id column="require_fields" property="requireFields"/>
        <id column="priority" property="priority"/>
        <id column="status" property="status"/>
        <id column="create_time" property="createTime"/>
        <id column="update_time" property="updateTime"/>
        <id column="create_user" property="createUser"/>
        <id column="update_user" property="updateUser"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        template_code,
        template_name,
        description,
        subject,
        content,
        require_fields,
        priority,
        status,
        create_time,
        update_time,
        create_user,
        update_user,
    </sql>

    <!-- 根据模板编号查询 -->
    <select id="selectTemplateByTemplateCode" resultType="com.auth.service.system.message.model.EmailTemplateEntity">
        SELECT *
        FROM sys_email_template
        WHERE template_code = #{templateCode}
          AND status = 1
          AND priority = (SELECT MAX(priority)
                          FROM sys_email_template
                          WHERE template_code = #{templateCode}
                            AND status = 1)
        LIMIT 1
    </select>

    <!-- 邮件模板分页列表 -->
    <select id="selectListByPage"
            resultType="com.auth.service.system.message.model.vo.EmailTemplatePageResponse">
        SELECT id,
        template_code AS templateCode,
        template_name AS templateName,
        description AS description,
        subject AS subject,
        priority AS priority,
        status AS status,
        create_time AS createTime,
        update_time AS updateTime,
        create_user AS createUser,
        update_user AS updateUser
        FROM sys_email_template

        <where>
            <if test="query.templateCode != null and query.templateCode != ''">
                AND template_code LIKE CONCAT('%', #{query.templateCode}, '%')
            </if>
            <if test="query.templateName != null and query.templateName != ''">
                AND template_name LIKE CONCAT('%', #{query.templateName}, '%')
            </if>
            <if test="query.subject != null and query.subject != ''">
                AND subject LIKE CONCAT('%', #{query.subject}, '%')
            </if>
            <if test="query.status != null">
                AND status = #{query.status}
            </if>
        </where>

        ORDER BY create_time DESC
    </select>
</mapper>
