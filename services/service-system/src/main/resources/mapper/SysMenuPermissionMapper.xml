<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.system.admin.mapper.SysMenuPermissionMapper">

    <!-- 查询菜单已分配权限（左连 sys_permission 获取权限名称；仅展示按钮类且启用未删的权限元数据） -->
    <select id="selectAssignedPermissionByMenuId"
            resultType="com.auth.service.system.admin.model.po.SysMenuAssignedPermissionPO">
        SELECT mp.permission_code,
               p.permission_name
        FROM sys_menu_permission mp
                 LEFT JOIN sys_permission p
                           ON p.permission_code = mp.permission_code
                               AND p.permission_type = 0
                               AND p.status = 1
                               AND p.is_deleted = 0
        WHERE mp.menu_id = #{menuId}
        ORDER BY p.permission_code
    </select>

    <!-- 批量查询菜单关联的操作权限编码（permission_type=0 按钮，且启用、未删除；供动态路由 meta） -->
    <select id="selectActiveButtonPermissionLinksByMenuIds"
            resultType="com.auth.service.system.admin.model.po.SysMenuPermissionLinkRowPO">
        SELECT mp.menu_id AS menuId,
               mp.permission_code AS permissionCode
        FROM sys_menu_permission mp
                 INNER JOIN sys_permission p ON p.permission_code = mp.permission_code
            AND p.permission_type = 0
            AND p.status = 1
            AND p.is_deleted = 0
        WHERE mp.menu_id IN
        <foreach collection="menuIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 批量插入菜单-权限关联 -->
    <insert id="batchInsertMenuPermissions">
        INSERT INTO sys_menu_permission (menu_id, permission_code) VALUES
        <foreach collection="permissionCodes" item="permissionCode" separator=",">
            (#{menuId}, #{permissionCode})
        </foreach>
    </insert>
</mapper>
