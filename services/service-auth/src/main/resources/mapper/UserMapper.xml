<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.auth.infrastructure.persistence.UserMapper">
    <!-- 按凭证维度查询用户：activeOnly 控制是否过滤 status=1 -->
    <select id="selectByCredential" resultType="com.auth.module.platform.persistence.model.UserEntity">
        SELECT
        id,
        username,
        password,
        status,
        nickname,
        email,
        phone,
        avatar,
        gender,
        birthday,
        age,
        employee_no,
        introduction,
        perm_version,
        create_time,
        update_time,
        create_user,
        update_user,
        version,
        remark,
        is_deleted
        FROM sys_user
        WHERE is_deleted = 0
        <if test="activeOnly">
            AND status = 1
        </if>
        <choose>
            <when test="field.name() == 'USERNAME'">
                AND username = #{value}
            </when>
            <when test="field.name() == 'EMAIL'">
                AND email = #{value}
            </when>
            <when test="field.name() == 'PHONE'">
                AND phone = #{value}
            </when>
        </choose>
    </select>

    <!-- 批量查询用户失效分桶状态 -->
    <select id="selectInvalidationStatesByUserIds"
            resultType="com.auth.service.auth.infrastructure.persistence.projection.UserInvalidationStateProjection">
        SELECT id AS userId,
        status,
        is_deleted
        FROM sys_user
        WHERE id IN
        <foreach collection="userIds" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </select>

</mapper>
