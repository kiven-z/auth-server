<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.auth.authorization.infrastructure.persistence.UserScopeMapper">

    <!-- 按用户 ID 查询数据范围（用户级覆盖，存在则不再读 role_scope） -->
    <select id="selectByUserId"
            resultType="com.auth.service.auth.authorization.infrastructure.persistence.projection.UserScopeProjection">
        SELECT scope_type,
        scope_dept_ids
        FROM user_scope
        WHERE user_id = #{userId}
        LIMIT 1
    </select>

</mapper>
