<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.auth.authorization.infrastructure.persistence.RoleScopeMapper">

    <!-- 按角色码批量查询 role_scope；roleCodes 为空时返回空集 -->
    <select id="selectByRoleCodes"
            resultType="com.auth.service.auth.authorization.infrastructure.persistence.projection.RoleScopeProjection">
        SELECT role_code,
        scope_type,
        scope_dept_ids
        FROM role_scope
        <where>
            <choose>
                <when test="roleCodes != null and roleCodes.size() > 0">
                    role_code IN
                    <foreach collection="roleCodes" item="roleCode" open="(" separator="," close=")">
                        #{roleCode}
                    </foreach>
                </when>
                <otherwise>
                    1 = 0
                </otherwise>
            </choose>
        </where>
    </select>

</mapper>
