<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.auth.mapper.AuthorizationImpactMapper">

    <!-- 单角色：引用公共片段 -->
    <select id="selectUserIdsByRoleCode" resultType="java.lang.Long">
        SELECT DISTINCT x.uid
        FROM (
        <include refid="com.auth.service.auth.mapper.UserRolesCteMapper.impactUserIdsByRoleCodeGrant"/>
        ) x
    </select>

    <select id="selectUserIdsByRoleCodes" resultType="java.lang.Long">
        SELECT DISTINCT x.uid
        FROM (
        <include refid="com.auth.service.auth.mapper.UserRolesCteMapper.impactUserIdsByRoleCodesInGrant"/>
        ) x
    </select>

    <select id="selectUserIdsByPermissionCodes" resultType="java.lang.Long">
        SELECT DISTINCT x.uid
        FROM (
        <include refid="com.auth.service.auth.mapper.UserRolesCteMapper.impactUserIdsByPermissionCodesGrant"/>
        ) x
    </select>

    <select id="selectUserIdsByPolicyCodes" resultType="java.lang.Long">
        SELECT DISTINCT x.uid
        FROM (
        <include refid="com.auth.service.auth.mapper.UserRolesCteMapper.impactUserIdsByPolicyCodesGrant"/>
        ) x
    </select>

    <!-- 部门成员 -->
    <select id="selectUserIdsByDeptIds" resultType="java.lang.Long">
        SELECT DISTINCT ud.user_id
        FROM user_dept ud
        WHERE ud.status = 0
          AND ud.dept_id IN
        <foreach collection="deptIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 岗位人员 -->
    <select id="selectUserIdsByPostIds" resultType="java.lang.Long">
        SELECT DISTINCT up.user_id
        FROM user_post up
        WHERE (up.status IS NULL OR up.status = 0)
          AND up.post_id IN
        <foreach collection="postIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>
